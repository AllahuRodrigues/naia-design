# Copy this file to .env.local and fill in your own Stripe secret key.
# Find it in the Stripe Dashboard under Developers > API keys.
# Use a sk_test_... key while testing, and your sk_live_... key once you're ready to accept real payments.
STRIPE_SECRET_KEY=

# Optional: only needed if the site's public URL differs from what Next.js detects automatically
# (e.g. when deployed). Used to build Stripe's success/cancel redirect links.
# NEXT_PUBLIC_SITE_URL=https://naiasousa.com
